rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isEmployer() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer';
    }

    // Returns the caller's email — first from the JWT token, then from their users doc
    function callerEmail() {
      return request.auth.token.email != null
        ? request.auth.token.email
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
            : "");
    }

    // Check if the email field on a document matches the currently signed-in user
    function isOwner(email) {
      return isAuth() && (
        email == request.auth.token.email ||
        email == callerEmail()
      );
    }

    // ── 1. Users ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuth();
    }

    // ── 2. Employees ───────────────────────────────────────────────
    match /employees/{docId} {
      allow read, write: if isAuth();
    }

    // ── 3. Leaves ──────────────────────────────────────────────────
    match /leaves/{leaveId} {
      allow read, write: if isAuth();
    }

    // ── 4. Payroll ─────────────────────────────────────────────────
    match /payroll/{payId} {
      allow read, write: if isAuth();
    }

    // ── 5. Documents ───────────────────────────────────────────────
    match /documents/{docId} {
      allow read, write: if isAuth();
    }

    // ── 6. Attendance ──────────────────────────────────────────────
    match /attendance/{attId} {
      allow read, write: if isAuth();
    }

    // ── 7. Tasks ───────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read, write: if isAuth();
    }

    // ── 8. Profile / System ────────────────────────────────────────
    match /profile_updates/{id}   { allow read, write: if isAuth(); }
    match /payslip_requests/{id}  { allow read, write: if isAuth(); }
    match /notifications/{id}     { allow read, write: if isAuth(); }
    match /chat_messages/{id}     { allow read, write: if isAuth(); }
    match /chat_reads/{id}        { allow read, write: if isAuth(); }
    match /leave_balances/{id}    { allow read, write: if isAuth(); }
    match /doc_templates/{id}     { allow read, write: if isAuth(); }
    match /hierarchy/{id}         { allow read, write: if isAuth(); }
    match /announcements/{id}     { allow read, write: if isAuth(); }

    // ── 9. Employer-Only ───────────────────────────────────────────
    match /companies/{id}         { allow read, write: if isAuth(); }
    match /companySettings/{id}   { allow read, write: if isAuth(); }
    match /teams/{id}             { allow read, write: if isAuth(); }
    match /jobs/{id}              { allow read, write: if isAuth(); }
  }
}
